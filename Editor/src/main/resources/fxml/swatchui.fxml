<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorder" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: #1f1f1f;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <VBox fx:id="vboxContainer" alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="8.0" left="8.0" right="8.0" />
         </BorderPane.margin>
         <children>
            <ScrollPane fx:id="swatchScrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="palette-scroll" vbarPolicy="ALWAYS" VBox.vgrow="ALWAYS">
               <content>
                  <StackPane styleClass="palette-content">
                     <children>
                        <FlowPane fx:id="swatchFlowPane" alignment="TOP_CENTER" columnHalignment="CENTER" hgap="6.0" vgap="6.0">
                           <padding>
                              <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                           </padding>
                        </FlowPane>
                        <Label fx:id="emptyLabel" styleClass="palette-empty-label" text="No objects in this palette" />
                     </children>
                  </StackPane>
               </content>
            </ScrollPane>
            <Button fx:id="objectViewBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Open Object Browser" VBox.vgrow="NEVER" />
         </children>
      </VBox>
   </center>
   <top>
      <BorderPane fx:id="titleContainer" style="-fx-background-color: #1f1f1f; -fx-border-color: #3a3a3a; -fx-border-width: 0 0 1 0;" BorderPane.alignment="TOP_CENTER">
         <padding>
            <Insets left="8.0" right="8.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="6.0" top="6.0" />
         </BorderPane.margin>
         <right>
            <HBox spacing="3.0" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="saveBtn" alignment="CENTER" mnemonicParsing="false" prefHeight="20.0" prefWidth="35.0" text="S">
                     <font>
                        <Font name="JetBrains Mono Regular" size="10.0" />
                     </font>
                     <tooltip>
                        <Tooltip text="Save Object Palette" />
                     </tooltip>
                  </Button>
                  <Button fx:id="loadBtn" alignment="CENTER" mnemonicParsing="false" prefHeight="20.0" prefWidth="35.0" text="L">
                     <font>
                        <Font name="JetBrains Mono Regular" size="10.0" />
                     </font>
                     <tooltip>
                        <Tooltip text="Load Object Palette" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
         </right>
      </BorderPane>
   </top>
   <stylesheets>
      <URL value="@../css/layout.css" />
      <URL value="@../css/modena_dark.css" />
   </stylesheets>
</BorderPane>
